# ============================================
# POS Pharmacy - Environment Configuration
# ລະບົບຂາຍຢາດີ - ການຕັ້ງຄ່າ
# ============================================
# ວິທີໃຊ້:
#   - cPanel: ຕັ້ງຄ່າໃນ cPanel > Setup php.ini / .htaccess
#   - VPS/Cloud: Copy ໄຟລ໌ນີ້ເປັນ .env ແລ້ວແກ້ໄຂ
#   - ຫຼື ແກ້ໄຂໂດຍກົງໃນ config/database.php
# ============================================

# Environment: development / production
APP_ENV=production

# Database
DB_HOST=localhost
DB_NAME=pospharma
DB_USER=your_db_username
DB_PASS=your_db_password

# Base URL (ຕ້ອງລົງທ້າຍດ້ວຍ /)
# ຕົວຢ່າງ: / ຫຼື /pospharma/ ຫຼື /pharmacy/
BASE_URL=/pospharma/

# ໂໝດລະບົບ: standalone (ແຍກກັນຢ່າງສົມບູນ ບໍ່ມີການ Sync ຂໍ້ມູນ)
SYNC_MODE=standalone
